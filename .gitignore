# Virtual Environments
.venv/
venv/
env/

# Python Cache & Bytecode
__pycache__/
*.pyc
*.pyo

# Flask Metadata
.flaskenv

# ---------------------------------
# DATABASE (Local files)
# ---------------------------------
data/
db/
*.mongodb

# ---------------------------------
# SECRETS (Do not upload!)
# ---------------------------------
pw_git.txt
.env
.env.local

# ---------------------------------
# AI / HEAVY DATA (CRITICAL)
# ---------------------------------
# Ignore the massive training dataset
backend/dataset/

# Ignore training logs and backups
backend/runs/

# Ignore base YOLO models (we don't need to upload standard ones)
backend/yolov8n.pt
backend/yolo11n.pt

# Ignore huge TensorFlow models
*.h5

# ---------------------------------
# MODEL EXCEPTIONS
# ---------------------------------
# Ignore ALL PyTorch models by default...
*.pt

# ...BUT force Git to keep ONLY our best custom model
!backend/best.pt

docs/